# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.Rproj.user

# secrets
.secrets/
secrets.yaml

# Large files
Outputs/Data/VegVault/VegVault.sqlite
# The 2.0.0 database, wherever secrets.yaml puts it inside the checkout,
#   with its work copy, the SQLite side files and the build manifest
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*_build_manifest.yml
Outputs/Data/VegVault/Flat_files/
!Outputs/Data/VegVault/Flat_files/Column_names/*.csv
Data/Processed/Classified_taxa/
Data/Temp/
# {targets} stores, one per pipeline
Data/Targets_data/
# Download cache of the release build (`producers: cache_dir`), one folder
#   per SHA-256 next to the pin manifest; without this line the downloaded
#   files count as untracked and the release build refuses to continue
Data/Producers/*/
# Validation reports, one set per build (stage 04_Validation); the
#   release build's report is attached to the GitHub release and the
#   data deposit instead
Outputs/Tables/validation_*

# debug
debug.R

# quarto
/.quarto/

**/*.quarto_ipynb
